{
  "name": "atomos-mirror-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Windows desktop sender for Atomos Mirror",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.atomos.mirror.desktop",
    "productName": "Atomos Mirror",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Atomos-Mirror-Setup-${version}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "qrcode": "^1.5.4"
  }
}
